# Copy this file to .env.local and fill in the values.

# ─── Client (compiled into the browser bundle — never put a secret here) ───
# Find these at: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Which account sees the admin-only UI (View feedback / View users / seed).
# On the test app, anyone signed in also has the Flashcards / Podcasts switch
# and the Spanish modules; the students' app hides them (src/lib/testApp.js).
# This is cosmetic gating only. The SERVER decides who may use Podcasts: the
# owner (ADMIN_EMAIL below) anywhere, and anyone signed in on the test app's
# hosts. Anything VITE_-prefixed is public, so it can never be a security
# boundary.
VITE_ADMIN_EMAIL=

# Only for building the planned iPhone app (npm run ios:students sets it): the
# deployment that app talks to. Left unset, it uses the owner's test app,
# https://dejareview-mlb.vercel.app.
# VITE_API_BASE=

# ─── Server only (Vercel project env vars — NOT VITE_-prefixed) ────────────
# Same project as VITE_SUPABASE_URL. The service role key bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The deploy owner. The real admin check, and the account whose Claude
# calls may fall back to ANTHROPIC_API_KEY below. On the test app the accounts
# listed in OWNERS_KEY_ON_TEST_APP (src/lib/testApp.js) may fall back to it too.
ADMIN_EMAIL=

# Needed for the linked cahier: api/cahier-sync.js and the daily cron parse
# every student's new classes with this key (the deploy owner pays for that).
# It also pays for Claude's review of anyone's feedback, a few a day per sender
# (api/_lib/feedbackReview.js), the morning look-alike questions and the weekly
# tests. Otherwise it is used only for requests from ADMIN_EMAIL (and, on the
# test app, the accounts in OWNERS_KEY_ON_TEST_APP): every other user
# brings their own key from the app's "Connect Claude account" dialog, kept in
# their browser and sent per request — never stored here or in the database.
# Unset, the cahier, the feedback review, the look-alike questions, the weekly
# tests and the morning status check all stop, and the admin must bring their
# own key like everyone else.
ANTHROPIC_API_KEY=

# The daily cahier check (api/cahier-daily.js, a Vercel cron). Vercel sends it
# as a bearer token with every cron request; without it the route refuses
# every caller, the cron included. Any long random string.
CRON_SECRET=

# Azure Speech (AZURE_SPEECH_KEY / AZURE_SPEECH_REGION) is no longer used.
# api/tts.js and api/pronounce.js were unauthenticated proxies to the deploy
# owner's Azure subscription and have been removed; speech now uses the
# browser's own speechSynthesis, which costs nothing.
